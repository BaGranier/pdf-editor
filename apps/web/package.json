{
  "name": "@pdf-editor-mvp/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview",
    "qa:e2e": "uv run --directory ../.. --project services/pdf-engine python -m scripts.run-qa",
    "qa:e2e:quick": "uv run --directory ../.. --project services/pdf-engine python -m scripts.run-qa --grep-invert @slow",
    "qa:e2e:chromium": "uv run --directory ../.. --project services/pdf-engine python -m scripts.run-qa --project=chromium",
    "qa:e2e:firefox": "uv run --directory ../.. --project services/pdf-engine python -m scripts.run-qa --project=firefox",
    "qa:e2e:headed": "uv run --directory ../.. --project services/pdf-engine python -m scripts.run-qa --headed",
    "qa:e2e:debug": "uv run --directory ../.. --project services/pdf-engine python -m scripts.run-qa --debug",
    "qa:e2e:report": "playwright show-report test-results/playwright-report",
    "qa:e2e:update-snapshots": "uv run --directory ../.. --project services/pdf-engine python -m scripts.run-qa --update-snapshots",
    "qa:e2e:typecheck": "tsc --noEmit -p tsconfig.e2e.json",
    "qa:docx-visual": "uv run --directory ../.. --project services/pdf-engine python -m scripts.validate-docx-visual-quality --required",
    "qa:report": "uv run --directory ../.. --project services/pdf-engine python -m scripts.generate-qa-report"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10"
  }
}
