{
  "name": "@pdf-editor-mvp/desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "web:dev": "npm --prefix ../web run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "web:build": "npm --prefix ../web run build",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "uv run --directory ../.. --project services/pdf-engine python -m scripts.build-backend-sidecar && tauri build",
    "desktop:check": "uv run --directory ../.. --project services/pdf-engine python -m scripts.desktop-check",
    "desktop:check:static": "uv run --directory ../.. --project services/pdf-engine python -m scripts.desktop-check --skip-cargo"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
